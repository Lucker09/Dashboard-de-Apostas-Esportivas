# Copie este arquivo para ".env" (na pasta bets-backend) e preencha os valores.
# O arquivo .env NÃO deve ser versionado.

DB_PASSWORD=troque-pela-senha-do-seu-mysql
# Gere uma chave aleatória, por exemplo:  openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Opcionais (os valores abaixo são os padrões):
# DB_URL=jdbc:mysql://localhost:3306/bets_dashboard?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
# DB_USERNAME=root
# JWT_EXPIRATION_MS=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
